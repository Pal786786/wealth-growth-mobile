{
  "title": "MFB — Scheduler & Alerts",
  "uid": "mfb-scheduler",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Registered jobs", "gridPos": {"x":0,"y":0,"w":8,"h":4},
      "targets": [{"expr": "sum(mfb_scheduler_jobs)"}]},
    {"id": 2, "type": "timeseries", "title": "Alerts by severity", "gridPos": {"x":0,"y":4,"w":24,"h":10},
      "targets": [{"expr": "sum by (severity) (mfb_finance_alerts)", "legendFormat": "{{severity}}"}]}
  ]
}
