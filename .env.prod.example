# ==============================================================================
# My Funding Bank — Production environment (.env.prod)
# ==============================================================================
# Copy this file to `.env.prod` in the repo root and fill in the values:
#     cp .env.prod.example .env.prod && nano .env.prod
# deploy/setup-vps.sh does this for you and auto-generates the secrets.
#
# NEVER commit .env.prod to GitHub (it is already in .gitignore).
# Keys left empty → that feature runs in demo/placeholder mode, the app still starts.
# Many provider keys (Cashfree, market data, etc.) can also be set later from the
# Admin panel → API Management, without touching this file.
# ==============================================================================

# ---------------- Runtime ----------------
ENVIRONMENT=production
LOG_LEVEL=info
# Gunicorn workers. 2 for a 2-4 GB VPS, 4 for 8 GB+.
WEB_CONCURRENCY=2
IMAGE_TAG=latest
ENABLE_METRICS=true

# ---------------- Domains ----------------
# All three must have a DNS "A record" pointing to this VPS's IP before SSL setup.
# API — the mobile app talks to this
DOMAIN_NAME=api.example.com
# Admin panel
ADMIN_DOMAIN=admin.example.com
# Marketing website
WEBSITE_DOMAIN=example.com
# Let's Encrypt expiry notices go here
CERTBOT_EMAIL=you@example.com

# Used in payment redirect links and referral links
FRONTEND_ORIGIN=https://example.com
APP_URL=https://example.com
REFERRAL_BASE_URL=https://example.com

# ---------------- MongoDB (runs inside Docker) ----------------
MONGO_ROOT_USER=mfbadmin
# Letters + numbers only (special characters break the connection URL)
MONGO_ROOT_PASSWORD=CHANGE_ME_generated_by_setup
MONGO_DB_NAME=mfb_prod
# Backend reads these two; docker-compose overrides MONGO_URL with the internal address.
DB_NAME=mfb_prod
MONGO_URL=mongodb://mongo:27017

# ---------------- Auth / security ----------------
# 64 random hex chars. Changing it logs out every user.
JWT_SECRET=CHANGE_ME_generated_by_setup
JWT_ALGORITHM=HS256
# Fernet key for encrypting KYC documents. DO NOT change after users upload KYC,
# or old documents can no longer be decrypted.
KYC_ENCRYPTION_KEY=CHANGE_ME_generated_by_setup
# true = OTP is shown/fixed (demo). Set false once MSG91 is configured.
OTP_DEMO_MODE=true
MARKET_DEBUG_ENABLED=false

# ---------------- SMS OTP (MSG91) ----------------
MSG91_AUTHKEY=
MSG91_WIDGET_ID=

# ---------------- Payments ----------------
# test | live
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------- AI features (advisor, news, signals, MF AI) ----------------
# Currently uses Emergent's universal LLM key (billed to your Emergent balance).
EMERGENT_LLM_KEY=

# ---------------- Push notifications ----------------
# Emergent push relay. Leave empty → push silently disabled (app still works).
EMERGENT_PUSH_KEY=

# ---------------- Market data ----------------
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
AMFI_ENABLED=true

# ---------------- KYC / identity ----------------
NSDL_PAN_API_KEY=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# ---------------- Mutual funds ----------------
CAMS_API_KEY=
KFINTECH_API_KEY=
MF_CENTRAL_API_KEY=

# ---------------- Forex / MT5 (real accounts) ----------------
MT5_SERVER=
MT5_MANAGER_API_URL=
MT5_MANAGER_LOGIN=
MT5_MANAGER_PASSWORD=

# ---------------- Backups ----------------
# local | s3
BACKUP_STORAGE=local
BACKUP_RETENTION_DAYS=14
# 21:00 UTC = 02:30 IST daily
BACKUP_CRON=0 21 * * *
BACKUP_ENCRYPT=false
BACKUP_ENCRYPT_PASSPHRASE=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=mfb-backups
